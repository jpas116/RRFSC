  <circle cx="24" cy="24" r="23" fill="var(--rose)" />
  <path d="M24 12c-3 4-9 5-9 11 0 5 4 8 9 8s9-3 9-8c0-6-6-7-9-11Z" fill="#fff" fill-opacity=".95"/>
  <path d="M24 16c-1.5 2.5-5 3-5 6.5 0 3 2.2 4.5 5 4.5s5-1.5 5-4.5c0-3.5-3.5-4-5-6.5Z" fill="var(--rose)"/>
  <path d="M24 31v6M20 36c1.5-2 3-2.5 4-2.5s2.5.5 4 2.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
