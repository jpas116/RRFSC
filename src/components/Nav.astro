---
const items = [
  ['/learn-to-skate', 'Learn to Skate'],
  ['/skate-with-us', 'Skate with us'],
  ['/coaches', 'Coaches'],
  ['/events', 'Events'],
  ['/calendar', 'Calendar'],
  ['/about', 'About'],
  ['/contact', 'Contact'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav class="main" aria-label="Main">
  <ul>
    {items.map(([href, label]) => (
      <li><a href={href} aria-current={path === href || (href !== '/' && path.startsWith(href + '/')) ? 'page' : undefined}>{label}</a></li>
    ))}
  </ul>
</nav>
