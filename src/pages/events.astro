---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { today, fmt } from '../lib/dates';
const now = today();
const all = (await getCollection('events')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const upcoming = all.filter((e) => (e.data.endDate ?? e.data.date) >= now).reverse();
const past = all.filter((e) => (e.data.endDate ?? e.data.date) < now);
const full = { month: 'long', day: 'numeric', year: 'numeric' } as const;
---
<Base title="Events" description="Upcoming competitions, shows and fundraisers at Red Rose Figure Skating Club.">
  <h1>Events</h1>
  {upcoming.length === 0 && <p class="lead">Nothing scheduled right now. Check back soon, or follow us on Instagram and Facebook.</p>}
  <div class="cards">
    {upcoming.map(({ data }) => (
      <div class="card">
        <h3>{data.title}</h3>
        <p><strong>{fmt(data.date, full)}</strong></p>
        {data.summary && <p>{data.summary}</p>}
        {data.registerUrl && <a class="btn" href={data.registerUrl}>Register</a>}
      </div>
    ))}
  </div>
  {past.length > 0 && (
    <>
      <h2>Past events</h2>
      <ul>{past.map(({ data }) => <li>{fmt(data.date, full)}: {data.title}</li>)}</ul>
    </>
  )}
</Base>
